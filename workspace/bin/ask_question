#!/usr/bin/env python3
import sys
import os
import argparse
import json
import urllib.request
import urllib.error

GATEWAY_URLS = [
    os.getenv("ANTIGRAVITY_GATEWAY_URL", "http://172.17.0.1:8080"),
    "http://127.0.0.1:8080",
    "http://host.docker.internal:8080",
]


def post_question(payload: dict) -> tuple[str, str]:
    """Posts question to gateway, returns (base_url, question_id)."""
    req_data = json.dumps(payload).encode("utf-8")
    for base in GATEWAY_URLS:
        url = f"{base}/gateway/api/questions"
        try:
            req = urllib.request.Request(url, data=req_data, headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=5) as resp:
                if resp.status == 200:
                    data = json.loads(resp.read().decode())
                    return base, data["question_id"]
        except Exception:
            continue
    raise RuntimeError("Could not connect to any Antigravity Gateway API endpoint.")


def wait_for_answer(base_url: str, qid: str, timeout: int) -> dict:
    url = f"{base_url}/gateway/api/questions/{qid}/wait?timeout={timeout}"
    try:
        req = urllib.request.Request(url)
        with urllib.request.urlopen(req, timeout=timeout + 15) as resp:
            return json.loads(resp.read().decode())
    except Exception as e:
        return {"status": "error", "message": str(e)}


def main():
    parser = argparse.ArgumentParser(description="Ask the user a structured multiple-choice question in the Antigravity UI.")
    parser.add_argument("--question", "-q", required=True, help="The question prompt to display")
    parser.add_argument("--options", "-o", required=True, help="Comma-separated options or JSON array string")
    parser.add_argument("--multi", "-m", action="store_true", help="Allow selecting multiple options")
    parser.add_argument("--timeout", type=int, default=120, help="Wait timeout in seconds (default: 120)")
    args = parser.parse_args()

    # Parse options list
    raw_opt = args.options.strip()
    if raw_opt.startswith("["):
        try:
            options = json.loads(raw_opt)
        except Exception:
            options = [opt.strip() for opt in raw_opt.split(",") if opt.strip()]
    else:
        options = [opt.strip() for opt in raw_opt.split(",") if opt.strip()]

    if not options:
        options = ["Yes", "No"]

    payload = {
        "question": args.question,
        "options": options,
        "is_multi_select": args.multi,
    }

    try:
        base_url, qid = post_question(payload)
    except Exception as e:
        print(f"[Antigravity] Gateway prompt error ({e}). Defaulting to recommended option: {options[0]}", file=sys.stderr)
        print(options[0])
        sys.exit(0)

    print(f"\n=======================================================", file=sys.stderr)
    print(f"❓ [Antigravity Decision Prompt Active in UI]", file=sys.stderr)
    print(f"   Question: {args.question}", file=sys.stderr)
    print(f"   Options:  {', '.join(options)}", file=sys.stderr)
    print(f"   Waiting for user response in UI (Card ID: {qid})...", file=sys.stderr)
    print(f"=======================================================\n", file=sys.stderr)

    result = wait_for_answer(base_url, qid, args.timeout)

    if result.get("status") == "answered":
        ans = result.get("answer")
        print(f"[Antigravity] Decision received: {ans}", file=sys.stderr)
        if isinstance(ans, list):
            print(", ".join(str(x) for x in ans))
        else:
            print(str(ans))
        sys.exit(0)
    elif result.get("status") == "timeout":
        # Fallback to recommended (first) option
        recommended = options[0]
        for opt in options:
            if "recommended" in opt.lower():
                recommended = opt
                break
        print(f"[Antigravity] User prompt timed out ({args.timeout}s). Proceeding with recommended: {recommended}", file=sys.stderr)
        print(recommended)
        sys.exit(0)
    else:
        # Fallback
        print(f"[Antigravity] Fallback to option: {options[0]}", file=sys.stderr)
        print(options[0])
        sys.exit(0)


if __name__ == "__main__":
    main()
